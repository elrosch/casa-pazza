<?xml version="1.0" encoding="utf-8"?>
<!-- Static app shortcuts. They start MainActivity like the home screen
     widgets do (home_widget launch action + casapazza:// URI), see
     WidgetRequest.fromUri in home_widget_sync.dart. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="voice"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="es.antonborri.home_widget.action.LAUNCH"
            android:data="casapazza://voice"
            android:targetPackage="de.eliasrosch.casa_pazza"
            android:targetClass="de.eliasrosch.casa_pazza.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan_short"
        android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent
            android:action="es.antonborri.home_widget.action.LAUNCH"
            android:data="casapazza://scan"
            android:targetPackage="de.eliasrosch.casa_pazza"
            android:targetClass="de.eliasrosch.casa_pazza.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="add_task"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_task"
        android:shortcutShortLabel="@string/shortcut_task_short"
        android:shortcutLongLabel="@string/shortcut_task_long">
        <intent
            android:action="es.antonborri.home_widget.action.LAUNCH"
            android:data="casapazza://add-task"
            android:targetPackage="de.eliasrosch.casa_pazza"
            android:targetClass="de.eliasrosch.casa_pazza.MainActivity" />
    </shortcut>
</shortcuts>
